{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Svyable/agent-business/schemas/incident-response-record.schema.json",
  "title": "Agent Incident Response Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","incident_id","status","severity","detected_at","updated_at","detection","affected_scope","impact","timeline","evidence","authority","containment","investigation","side_effects","customer_impact","recovery","corrective_actions","privacy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "incident_id": {"type":"string","minLength":1},
    "status": {"enum":["detected","triaged","contained","investigating","remediating","recovery_verification","monitoring","closed","reopened"]},
    "severity": {"enum":["SEV0","SEV1","SEV2","SEV3","SEV4","unclassified"]},
    "detected_at": {"type":"string","format":"date-time"},
    "updated_at": {"type":"string","format":"date-time"},
    "detection": {"type":"object","required":["source","summary"],"properties":{"source":{"type":"string"},"summary":{"type":"string"},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "affected_scope": {"type":"object","required":["capabilities","release_ids","tenant_count"],"properties":{"capabilities":{"type":"array","items":{"type":"string"}},"release_ids":{"type":"array","items":{"type":"string"}},"tenant_count":{"type":"integer","minimum":0},"dependency_ids":{"type":"array","items":{"type":"string"}}}},
    "impact": {"type":"object","required":["availability","security_or_data","authority_violation","economic_side_effects","summary"],"properties":{"availability":{"type":"boolean"},"security_or_data":{"type":"boolean"},"authority_violation":{"type":"boolean"},"economic_side_effects":{"type":"boolean"},"summary":{"type":"string"},"severity_evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "timeline": {"type":"array","items":{"type":"object","required":["at","event","classification"],"properties":{"at":{"type":"string","format":"date-time"},"event":{"type":"string"},"classification":{"enum":["observed","decision","action","hypothesis"]},"evidence_ids":{"type":"array","items":{"type":"string"}}}}},
    "evidence": {"type":"array","items":{"type":"object","required":["id","type","observed_at","status","reference"],"properties":{"id":{"type":"string","minLength":1},"type":{"enum":["trace","tool_receipt","policy_decision","authorization_event","release_manifest","alert","audit_event","billing_event","customer_impact","recovery_test","corrective_action_test","other"]},"observed_at":{"type":"string","format":"date-time"},"status":{"enum":["current","superseded","unverified"]},"reference":{"type":"string"},"sha256":{"type":"string"}}}},
    "authority": {"type":"object","required":["can_pause_intake","can_disable_tool","can_isolate_tenant","can_revoke_authority","can_rollback_release","can_contact_customers","can_issue_credits","can_move_money","evidence_ids"],"properties":{"can_pause_intake":{"type":"boolean"},"can_disable_tool":{"type":"boolean"},"can_isolate_tenant":{"type":"boolean"},"can_revoke_authority":{"type":"boolean"},"can_rollback_release":{"type":"boolean"},"can_contact_customers":{"type":"boolean"},"can_issue_credits":{"type":"boolean"},"can_move_money":{"type":"boolean"},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "containment": {"type":"object","required":["actions","contained_at"],"properties":{"actions":{"type":"array","items":{"type":"object","required":["type","executed","authority_required","evidence_ids"],"properties":{"type":{"enum":["pause_intake","disable_tool","read_only_mode","isolate_tenant","freeze_release","disable_dependency","revoke_authority","kill_switch","other"]},"executed":{"type":"boolean"},"authority_required":{"type":"boolean"},"evidence_ids":{"type":"array","items":{"type":"string"}}}}},"contained_at":{"type":["string","null"],"format":"date-time"}}},
    "investigation": {"type":"object","required":["facts","hypotheses","unknowns","root_cause_status"],"properties":{"facts":{"type":"array","items":{"type":"object","required":["statement","evidence_ids"],"properties":{"statement":{"type":"string"},"evidence_ids":{"type":"array","items":{"type":"string"}}}}},"hypotheses":{"type":"array","items":{"type":"string"}},"unknowns":{"type":"array","items":{"type":"string"}},"root_cause_status":{"enum":["unknown","hypothesis","confirmed"]},"root_cause":{"type":["string","null"]},"root_cause_evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "side_effects": {"type":"array","items":{"type":"object","required":["operation_id","kind","state","material","evidence_ids"],"properties":{"operation_id":{"type":"string"},"kind":{"type":"string"},"state":{"enum":["confirmed_success","confirmed_failure","duplicate","compensated","uncertain"]},"material":{"type":"boolean"},"amount_minor":{"type":"integer","minimum":0},"evidence_ids":{"type":"array","items":{"type":"string"}}}}},
    "customer_impact": {"type":"object","required":["assessed","affected_count","notification_decision","owner"],"properties":{"assessed":{"type":"boolean"},"affected_count":{"type":"integer","minimum":0},"notification_decision":{"enum":["not_required","required","pending_policy_or_legal_review","unknown"]},"owner":{"type":"string"},"evidence_ids":{"type":"array","items":{"type":"string"}},"communication_evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "recovery": {"type":"object","required":["trigger_removed","identity_authority_healthy","security_policy_healthy","data_integrity_healthy","side_effects_reconciled","observability_healthy","production_authority_valid","verification_evidence_ids","verified_at"],"properties":{"trigger_removed":{"type":"boolean"},"identity_authority_healthy":{"type":"boolean"},"security_policy_healthy":{"type":"boolean"},"data_integrity_healthy":{"type":"boolean"},"side_effects_reconciled":{"type":"boolean"},"observability_healthy":{"type":"boolean"},"production_authority_valid":{"type":"boolean"},"verification_evidence_ids":{"type":"array","items":{"type":"string"}},"verified_at":{"type":["string","null"],"format":"date-time"}}},
    "corrective_actions": {"type":"array","items":{"type":"object","required":["id","class","owner","due_at","status","verification_evidence_ids"],"properties":{"id":{"type":"string"},"class":{"enum":["prevent","detect","contain","recover","govern"]},"owner":{"type":"string"},"due_at":{"type":"string","format":"date-time"},"status":{"enum":["open","in_progress","verified","waived"]},"verification_evidence_ids":{"type":"array","items":{"type":"string"}},"waiver_reason":{"type":["string","null"]}}}},
    "privacy": {"type":"object","required":["contains_credentials","contains_private_customer_data","contains_secret_prompts","contains_exploit_instructions","public_disclosure_confirmed"],"properties":{"contains_credentials":{"type":"boolean"},"contains_private_customer_data":{"type":"boolean"},"contains_secret_prompts":{"type":"boolean"},"contains_exploit_instructions":{"type":"boolean"},"public_disclosure_confirmed":{"type":"boolean"}}}
  }
}