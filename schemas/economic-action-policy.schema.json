{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.business/schemas/economic-action-policy.schema.json",
  "title": "Agent Business Economic Action Policy",
  "description": "Deterministic controls for one class of autonomous economic action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "action",
    "exposure",
    "identity",
    "authority",
    "velocity",
    "decision_bands",
    "evidence",
    "reserve",
    "incident"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "active", "retired"]},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reversibility"],
      "properties": {
        "type": {
          "enum": [
            "purchase",
            "payout",
            "refund",
            "credit",
            "referral_reward",
            "marketplace_trade",
            "procurement_award",
            "withdrawal",
            "promotion",
            "discount",
            "service_credit",
            "other"
          ]
        },
        "reversibility": {"enum": ["high", "medium", "low"]},
        "description": {"type": "string", "maxLength": 500}
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "max_single_amount", "max_daily_amount"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "max_single_amount": {"type": "number", "minimum": 0},
        "max_daily_amount": {"type": "number", "minimum": 0},
        "max_lifetime_amount": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_assurance", "beneficiary_verification_required"],
      "properties": {
        "minimum_assurance": {"enum": ["anonymous", "self_declared", "verified", "strong_verified"]},
        "beneficiary_verification_required": {"type": "boolean"},
        "new_identity_cooling_period_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "must_be_current", "must_cover_action", "must_cover_amount"],
      "properties": {
        "required": {"type": "boolean"},
        "must_be_current": {"type": "boolean"},
        "must_cover_action": {"type": "boolean"},
        "must_cover_amount": {"type": "boolean"},
        "second_approver_above": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "velocity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_actions_per_hour", "max_actions_per_day"],
      "properties": {
        "max_actions_per_minute": {"type": ["integer", "null"], "minimum": 1},
        "max_actions_per_hour": {"type": "integer", "minimum": 1},
        "max_actions_per_day": {"type": "integer", "minimum": 1},
        "max_new_beneficiaries_per_day": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "decision_bands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_max_risk", "step_up_max_risk", "review_max_risk", "deny_above_risk", "fail_closed_on_missing_risk"],
      "properties": {
        "allow_max_risk": {"type": "number", "minimum": 0, "maximum": 1},
        "step_up_max_risk": {"type": "number", "minimum": 0, "maximum": 1},
        "review_max_risk": {"type": "number", "minimum": 0, "maximum": 1},
        "deny_above_risk": {"type": "number", "minimum": 0, "maximum": 1},
        "fail_closed_on_missing_risk": {"type": "boolean"},
        "hold_seconds_above_step_up": {"type": "integer", "minimum": 0}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_references", "retain_decision_version"],
      "properties": {
        "required_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "authority",
              "order_or_contract",
              "pricing",
              "delivery",
              "acceptance",
              "payment_or_settlement",
              "risk_decision"
            ]
          }
        },
        "retain_decision_version": {"type": "boolean"},
        "tamper_evident_required": {"type": "boolean"}
      }
    },
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "basis_points", "settlement_hold_seconds"],
      "properties": {
        "required": {"type": "boolean"},
        "basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "settlement_hold_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kill_switch_required", "freeze_on_compromise", "preserve_evidence"],
      "properties": {
        "kill_switch_required": {"type": "boolean"},
        "freeze_on_compromise": {"type": "boolean"},
        "preserve_evidence": {"type": "boolean"},
        "review_queue": {"type": "string", "maxLength": 128}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {"type": "string", "maxLength": 128},
        "effective_at": {"type": ["string", "null"], "format": "date-time"},
        "review_by": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": "string", "maxLength": 1000}
      }
    }
  }
}