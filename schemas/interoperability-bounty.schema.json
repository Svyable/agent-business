{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Interoperability Bounty",
  "type": "object",
  "required": [
    "schema_version",
    "bounty_id",
    "status",
    "target",
    "demand",
    "funding",
    "builder",
    "award",
    "acceptance",
    "unlock_verification",
    "payout",
    "value_attribution",
    "conflicts",
    "authority",
    "privacy"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bounty_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "open", "awarded", "submitted", "accepted", "closed", "cancelled"]},
    "target": {
      "type": "object",
      "required": ["convention_id", "spec_version", "corridor_population_ref", "population_hash", "selection_rule_hash", "minimum_incremental_reachable_corridors", "acceptance_criteria_hash", "tests"],
      "properties": {
        "convention_id": {"type": "string", "minLength": 1},
        "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "corridor_population_ref": {"type": "string", "minLength": 1},
        "population_hash": {"type": "string", "minLength": 1},
        "selection_rule_hash": {"type": "string", "minLength": 1},
        "minimum_incremental_reachable_corridors": {"type": "integer", "minimum": 1},
        "acceptance_criteria_hash": {"type": "string", "minLength": 1},
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "procedure"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "procedure": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "demand": {
      "type": "object",
      "required": ["evidence_class", "snapshot_ref", "corridor_count", "qualified_value_minor_range", "currency", "evidence_refs", "demand_backed_claim"],
      "properties": {
        "evidence_class": {"enum": ["synthetic_test", "self_declared_intent", "observed_commercial_demand", "verified_commercial_demand"]},
        "snapshot_ref": {"type": "string", "minLength": 1},
        "corridor_count": {"type": "integer", "minimum": 0},
        "qualified_value_minor_range": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}
          ]
        },
        "currency": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "demand_backed_claim": {"type": "boolean"}
      }
    },
    "funding": {
      "type": "object",
      "required": ["repo_custodies_funds", "currency", "payout_cap_minor", "custody_state", "custody_provider_ref", "custody_evidence_ref", "sponsors"],
      "properties": {
        "repo_custodies_funds": {"const": false},
        "currency": {"type": ["string", "null"]},
        "payout_cap_minor": {"type": "integer", "minimum": 0},
        "custody_state": {"enum": ["none", "external_unverified", "external_verified"]},
        "custody_provider_ref": {"type": ["string", "null"]},
        "custody_evidence_ref": {"type": ["string", "null"]},
        "sponsors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sponsor_ref", "commitment_minor", "currency", "state", "expires_at", "verification_evidence_ref"],
            "properties": {
              "sponsor_ref": {"type": "string", "minLength": 1},
              "commitment_minor": {"type": "integer", "minimum": 1},
              "currency": {"type": "string", "minLength": 1},
              "state": {"enum": ["pledged", "verified", "revoked", "expired"]},
              "expires_at": {"type": "string", "minLength": 1},
              "verification_evidence_ref": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "builder": {
      "type": "object",
      "required": ["state", "builder_ref", "proposal_ref", "implementation_cost_minor_range", "currency", "compatibility_profile_target_ref", "submission_evidence_refs"],
      "properties": {
        "state": {"enum": ["none", "proposed", "selected", "submitted"]},
        "builder_ref": {"type": ["string", "null"]},
        "proposal_ref": {"type": ["string", "null"]},
        "implementation_cost_minor_range": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}
          ]
        },
        "currency": {"type": ["string", "null"]},
        "compatibility_profile_target_ref": {"type": ["string", "null"]},
        "submission_evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "award": {
      "type": "object",
      "required": ["state", "builder_ref", "acceptance_criteria_hash", "awarded_at"],
      "properties": {
        "state": {"enum": ["not_awarded", "awarded"]},
        "builder_ref": {"type": ["string", "null"]},
        "acceptance_criteria_hash": {"type": ["string", "null"]},
        "awarded_at": {"type": ["string", "null"]}
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["state", "criteria_hash", "criteria_locked_at", "test_evidence_refs", "evaluated_at"],
      "properties": {
        "state": {"enum": ["not_started", "failed", "passed"]},
        "criteria_hash": {"type": "string", "minLength": 1},
        "criteria_locked_at": {"type": ["string", "null"]},
        "test_evidence_refs": {"type": "array", "items": {"type": "string"}},
        "evaluated_at": {"type": ["string", "null"]}
      }
    },
    "unlock_verification": {
      "type": "object",
      "required": ["state", "baseline_snapshot_ref", "post_snapshot_ref", "same_population_confirmed", "same_selection_rule_confirmed", "incremental_reachable_corridors", "evidence_ref", "verified_at"],
      "properties": {
        "state": {"enum": ["not_started", "failed", "verified"]},
        "baseline_snapshot_ref": {"type": ["string", "null"]},
        "post_snapshot_ref": {"type": ["string", "null"]},
        "same_population_confirmed": {"type": "boolean"},
        "same_selection_rule_confirmed": {"type": "boolean"},
        "incremental_reachable_corridors": {"type": "integer", "minimum": 0},
        "evidence_ref": {"type": ["string", "null"]},
        "verified_at": {"type": ["string", "null"]}
      }
    },
    "payout": {
      "type": "object",
      "required": ["state", "amount_minor", "currency", "payout_authority_ref", "payment_ref", "settlement_evidence_ref"],
      "properties": {
        "state": {"enum": ["not_earned", "earned", "external_execution_pending", "settled", "failed"]},
        "amount_minor": {"type": "integer", "minimum": 0},
        "currency": {"type": ["string", "null"]},
        "payout_authority_ref": {"type": ["string", "null"]},
        "payment_ref": {"type": ["string", "null"]},
        "settlement_evidence_ref": {"type": ["string", "null"]}
      }
    },
    "value_attribution": {
      "type": "object",
      "required": ["overlap_group_id", "overlap_policy", "overlap_check_evidence_ref", "claims_exclusive_incremental_value"],
      "properties": {
        "overlap_group_id": {"type": ["string", "null"]},
        "overlap_policy": {"enum": ["shared_population_do_not_sum", "disjoint_population", "independent_no_value_claim"]},
        "overlap_check_evidence_ref": {"type": ["string", "null"]},
        "claims_exclusive_incremental_value": {"type": "boolean"}
      }
    },
    "conflicts": {
      "type": "object",
      "required": ["builder_related_to_sponsors", "disclosure"],
      "properties": {
        "builder_related_to_sponsors": {"type": "boolean"},
        "disclosure": {"type": "string"}
      }
    },
    "authority": {
      "type": "object",
      "required": ["acceptance_grants_authority", "acceptance_executes_payment", "bounty_grants_deployment_authority"],
      "properties": {
        "acceptance_grants_authority": {"const": false},
        "acceptance_executes_payment": {"const": false},
        "bounty_grants_deployment_authority": {"const": false}
      }
    },
    "privacy": {
      "type": "object",
      "required": ["contains_credentials", "contains_payment_secrets", "contains_private_counterparty_data", "contains_confidential_deal_terms", "public_disclosure_confirmed"],
      "properties": {
        "contains_credentials": {"const": false},
        "contains_payment_secrets": {"const": false},
        "contains_private_counterparty_data": {"const": false},
        "contains_confidential_deal_terms": {"const": false},
        "public_disclosure_confirmed": {"const": true}
      }
    }
  },
  "additionalProperties": false
}
