{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Svyable/agent-business/schemas/complaint-redress-record.schema.json",
  "title": "Agent Complaint and Redress Record",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version","record_id","status","updated_at","complainant","scope","triage","allegation","facts","interpretation","decision","remediation","appeal","preservation","communication","authority","evidence","privacy"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "record_id": {"type":"string","minLength":1},
    "status": {"enum":["received","acknowledged","triaged","investigating","remediation_proposed","awaiting_approval","resolved","rejected_with_reason","appealed","closed"]},
    "updated_at": {"type":"string","format":"date-time"},
    "complainant": {"type":"object","required":["safe_id","channel_discoverable","human_escalation_available"],"properties":{"safe_id":{"type":"string"},"channel_discoverable":{"type":"boolean"},"human_escalation_available":{"type":"boolean"}}},
    "scope": {"type":"object","required":["tenant_ref","agent_id","release_id","disputed_action_id"],"properties":{"tenant_ref":{"type":"string"},"agent_id":{"type":["string","null"]},"release_id":{"type":["string","null"]},"disputed_action_id":{"type":["string","null"]}}},
    "triage": {"type":"object","required":["categories","severity","owner","human_review_required"],"properties":{"categories":{"type":"array","items":{"enum":["safety_security","privacy","billing_financial","unauthorized_action","transparency_deception","service_quality","discrimination_fairness","contractual_scope","other"]}},"severity":{"enum":["low","medium","high","critical"]},"owner":{"type":["string","null"]},"human_review_required":{"type":"boolean"}}},
    "allegation": {"type":"object","required":["summary"],"properties":{"summary":{"type":"string"}}},
    "facts": {"type":"array","items":{"type":"object","required":["statement","evidence_ids"],"properties":{"statement":{"type":"string"},"evidence_ids":{"type":"array","items":{"type":"string"}}}}},
    "interpretation": {"type":"object","required":["summary","uncertainty_material"],"properties":{"summary":{"type":"string"},"uncertainty_material":{"type":"boolean"}}},
    "decision": {"type":"object","required":["disposition","rationale","decision_maker","independent_from_execution_agent","evidence_ids"],"properties":{"disposition":{"enum":["pending","remedy_approved","no_remedy","rejected","other"]},"rationale":{"type":"string"},"decision_maker":{"type":["string","null"]},"independent_from_execution_agent":{"type":"boolean"},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "remediation": {"type":"object","required":["consequential","requested","executed","verified","idempotency_key","evidence_ids"],"properties":{"consequential":{"type":"boolean"},"requested":{"type":"array","items":{"type":"string"}},"executed":{"type":"array","items":{"type":"string"}},"verified":{"type":"boolean"},"idempotency_key":{"type":["string","null"]},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "appeal": {"type":"object","required":["requested","independent_review_required","independent_reviewer","resolved"],"properties":{"requested":{"type":"boolean"},"independent_review_required":{"type":"boolean"},"independent_reviewer":{"type":["string","null"]},"resolved":{"type":"boolean"}}},
    "preservation": {"type":"object","required":["hold_active","evidence_preserved","deletion_blocked_while_held"],"properties":{"hold_active":{"type":"boolean"},"evidence_preserved":{"type":"boolean"},"deletion_blocked_while_held":{"type":"boolean"}}},
    "communication": {"type":"object","required":["acknowledged","decision_delivered","evidence_ids"],"properties":{"acknowledged":{"type":"boolean"},"decision_delivered":{"type":"boolean"},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "authority": {"type":"object","required":["can_approve_consequential_remedy","can_close","evidence_ids"],"properties":{"can_approve_consequential_remedy":{"type":"boolean"},"can_close":{"type":"boolean"},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "evidence": {"type":"array","items":{"type":"object","required":["id","type","status","observed_at","reference"],"properties":{"id":{"type":"string"},"type":{"type":"string"},"status":{"enum":["current","stale","superseded"]},"observed_at":{"type":"string","format":"date-time"},"reference":{"type":"string"}}}},
    "privacy": {"type":"object","required":["contains_credentials","contains_private_customer_data","contains_raw_private_prompts","contains_payment_data","contains_privileged_legal_advice","public_disclosure_confirmed"],"properties":{"contains_credentials":{"const":false},"contains_private_customer_data":{"const":false},"contains_raw_private_prompts":{"const":false},"contains_payment_data":{"const":false},"contains_privileged_legal_advice":{"const":false},"public_disclosure_confirmed":{"const":true}}}
  }
}
