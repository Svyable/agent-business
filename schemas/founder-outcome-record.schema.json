{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Svyable/agent-business/schemas/founder-outcome-record.schema.json",
  "title": "Agent Business Founder Outcome Record",
  "description": "Public, machine-readable evidence record for a founder outcome or case-study candidate. It separates observed facts, self-reported claims, estimates, and editorial interpretation and must not contain secrets or private customer data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome_id",
    "updated_at",
    "publication_status",
    "reporter",
    "business",
    "repository_usage",
    "baseline",
    "intervention",
    "outcomes",
    "evidence",
    "claims",
    "lessons",
    "privacy"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "outcome_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9._-]+$"},
    "updated_at": {"type": "string", "format": "date-time"},
    "publication_status": {"enum": ["draft", "candidate", "published", "retired"]},
    "source_issue": {"type": ["integer", "null"], "minimum": 1},
    "reporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "identity_confidence"],
      "properties": {
        "type": {"enum": ["human_founder", "autonomous_agent", "human_using_agent", "team", "other"]},
        "identity_confidence": {"enum": ["self_declared", "publicly_attributed", "verified_by_editor"]},
        "public_name": {"type": ["string", "null"], "maxLength": 160},
        "runtime": {"type": ["string", "null"], "maxLength": 160}
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_name", "model", "vertical", "customer"],
      "properties": {
        "public_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "model": {"type": "string", "minLength": 1, "maxLength": 160},
        "vertical": {"type": "string", "minLength": 1, "maxLength": 160},
        "customer": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "repository_usage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_id", "use"],
        "properties": {
          "resource_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "use": {"type": "string", "minLength": 1, "maxLength": 320}
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "period"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 1200},
        "period": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "started_at"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "value_driver", "unit", "direction", "baseline_value", "result_value", "attribution_confidence", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "value_driver": {"enum": ["revenue", "cost", "speed", "quality", "risk", "retention", "learning", "other"]},
          "unit": {"type": "string", "minLength": 1, "maxLength": 64},
          "direction": {"enum": ["increase_is_better", "decrease_is_better", "target_range", "descriptive"]},
          "baseline_value": {"type": ["number", "string", "null"]},
          "result_value": {"type": ["number", "string", "null"]},
          "attribution_confidence": {"enum": ["low", "medium", "high"]},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "economics": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "revenue_minor": {"type": ["integer", "null"], "minimum": 0},
        "delivery_cost_minor": {"type": ["integer", "null"], "minimum": 0},
        "human_review_minutes": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "description", "observed_at", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "type": {"enum": ["public_artifact", "public_metric", "reproducible_calculation", "self_report", "third_party_source", "editorial_note"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 1200},
          "public_url": {"type": ["string", "null"], "format": "uri"},
          "observed_at": {"type": "string", "format": "date-time"},
          "status": {"enum": ["draft", "current", "disputed", "superseded"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification", "statement", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "classification": {"enum": ["observed_fact", "self_reported", "estimate", "editorial_interpretation"]},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1600},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 800}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_disclosure_confirmed", "contains_secrets", "contains_private_prompts", "contains_payment_data", "contains_private_customer_data"],
      "properties": {
        "public_disclosure_confirmed": {"const": true},
        "contains_secrets": {"const": false},
        "contains_private_prompts": {"const": false},
        "contains_payment_data": {"const": false},
        "contains_private_customer_data": {"const": false}
      }
    },
    "editorial": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "review_notes": {"type": ["string", "null"], "maxLength": 1600}
      }
    }
  }
}
