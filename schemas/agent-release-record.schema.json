{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Svyable/agent-business/schemas/agent-release-record.schema.json",
  "title": "Agent Release Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_id", "revision_id", "parent_revision_id", "status", "updated_at",
    "change", "baseline", "dependencies", "authority", "evaluation", "rollout", "customer_impact",
    "compatibility", "rollback", "deprecation", "observability", "evidence", "privacy"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "parent_revision_id": {"type": ["string", "null"]},
    "status": {"enum": ["proposed", "built", "evaluated", "approved", "canary", "rolling_out", "stable", "rolled_back", "deprecated", "retired"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "repository_resources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "classifications", "risk_level", "affected_components"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "classifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["patch", "behavioral", "commercial", "security", "data", "authority", "breaking"]}},
        "risk_level": {"enum": ["low", "medium", "high", "critical"]},
        "affected_components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["models", "tools", "prompts", "policies", "contracts", "memory_or_state"],
          "properties": {
            "models": {"type": "array", "items": {"type": "string"}},
            "tools": {"type": "array", "items": {"type": "string"}},
            "prompts": {"type": "array", "items": {"type": "string"}},
            "policies": {"type": "array", "items": {"type": "string"}},
            "contracts": {"type": "array", "items": {"type": "string"}},
            "memory_or_state": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_revision_id", "evidence_ids"],
      "properties": {
        "production_revision_id": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "previous_version", "new_version", "compatibility_checked", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["model", "provider", "tool", "runtime", "library", "data_source"]},
          "previous_version": {"type": ["string", "null"]},
          "new_version": {"type": "string", "minLength": 1},
          "compatibility_checked": {"type": "boolean"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widened", "change_summary", "reapproved", "evidence_ids"],
      "properties": {
        "widened": {"type": "boolean"},
        "change_summary": {"type": "string"},
        "reapproved": {"type": "boolean"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_compared", "regression_suite_passed", "safety_policy_passed", "tool_use_checked", "latency_delta_checked", "cost_delta_checked", "human_review_delta_checked", "critical_regressions", "evidence_ids"],
      "properties": {
        "baseline_compared": {"type": "boolean"},
        "regression_suite_passed": {"type": "boolean"},
        "safety_policy_passed": {"type": "boolean"},
        "tool_use_checked": {"type": "boolean"},
        "latency_delta_checked": {"type": "boolean"},
        "cost_delta_checked": {"type": "boolean"},
        "human_review_delta_checked": {"type": "boolean"},
        "critical_regressions": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canary_required", "canary_percent", "current_percent", "hold_period_minutes", "promotion_criteria", "stop_conditions", "rollback_revision_id", "production_metrics_evidence_ids"],
      "properties": {
        "canary_required": {"type": "boolean"},
        "canary_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "current_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "hold_period_minutes": {"type": "integer", "minimum": 0},
        "promotion_criteria": {"type": "array", "items": {"type": "string"}},
        "stop_conditions": {"type": "array", "items": {"type": "string"}},
        "rollback_revision_id": {"type": ["string", "null"]},
        "production_metrics_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "customer_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material", "dimensions", "communication_required", "communication_complete", "evidence_ids"],
      "properties": {
        "material": {"type": "boolean"},
        "dimensions": {"type": "array", "uniqueItems": true, "items": {"enum": ["behavior", "data", "pricing", "metering", "availability", "compatibility", "security", "none"]}},
        "communication_required": {"type": "boolean"},
        "communication_complete": {"type": "boolean"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine_contracts_checked", "stored_state_checked", "integrations_checked", "downstream_consumers_checked", "breaking_change", "migration_path_defined", "evidence_ids"],
      "properties": {
        "machine_contracts_checked": {"type": "boolean"},
        "stored_state_checked": {"type": "boolean"},
        "integrations_checked": {"type": "boolean"},
        "downstream_consumers_checked": {"type": "boolean"},
        "breaking_change": {"type": "boolean"},
        "migration_path_defined": {"type": "boolean"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defined", "tested", "state_migration_reversible", "irreversible_changes", "owner_defined", "evidence_ids"],
      "properties": {
        "defined": {"type": "boolean"},
        "tested": {"type": "boolean"},
        "state_migration_reversible": {"type": "boolean"},
        "irreversible_changes": {"type": "array", "items": {"type": "string"}},
        "owner_defined": {"type": "boolean"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notice_required", "notice_complete", "support_window_defined", "migration_path_defined", "migration_complete", "sunset_criteria_defined", "evidence_ids"],
      "properties": {
        "notice_required": {"type": "boolean"},
        "notice_complete": {"type": "boolean"},
        "support_window_defined": {"type": "boolean"},
        "migration_path_defined": {"type": "boolean"},
        "migration_complete": {"type": "boolean"},
        "sunset_criteria_defined": {"type": "boolean"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_rate", "quality_safety", "latency", "cost_per_success", "escalation_rate", "rollback_rate", "adoption", "customer_incidents"],
      "properties": {
        "error_rate": {"type": "boolean"},
        "quality_safety": {"type": "boolean"},
        "latency": {"type": "boolean"},
        "cost_per_success": {"type": "boolean"},
        "escalation_rate": {"type": "boolean"},
        "rollback_rate": {"type": "boolean"},
        "adoption": {"type": "boolean"},
        "customer_incidents": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "status", "observed_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["release_artifact", "production_baseline", "eval_result", "production_metrics", "authority_grant", "compatibility_test", "customer_notice", "dependency_provenance", "rollback_test", "migration_evidence", "approval_record", "public_artifact"]},
          "status": {"enum": ["current", "stale", "superseded"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "public_url": {"type": "string", "format": "uri"},
          "note": {"type": "string"}
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_credentials", "contains_private_customer_data", "contains_private_prompts", "public_disclosure_confirmed"],
      "properties": {
        "contains_credentials": {"const": false},
        "contains_private_customer_data": {"const": false},
        "contains_private_prompts": {"const": false},
        "public_disclosure_confirmed": {"const": true}
      }
    }
  }
}
