{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Svyable/agent-business/schemas/machine-payment-record.schema.json",
  "title": "Agent Machine Payment Record",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version","payment_id","status","updated_at","commercial_obligation","parties","authorization","execution","settlement","economics","reconciliation","dispute","reversal","authority","evidence","privacy"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "payment_id": {"type":"string","minLength":1},
    "status": {"enum":["proposed","authorized","submitted","accepted","pending_settlement","settled","failed","disputed","reversed","reconciliation_break","reconciled","closed"]},
    "updated_at": {"type":"string","format":"date-time"},
    "commercial_obligation": {"type":"object","required":["type","reference","purpose"],"properties":{"type":{"enum":["api_usage","compute","data","service","other"]},"reference":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1}}},
    "parties": {"type":"object","required":["payer_agent_id","payer_principal_ref","payee_ref"],"properties":{"payer_agent_id":{"type":"string","minLength":1},"payer_principal_ref":{"type":"string","minLength":1},"payee_ref":{"type":"string","minLength":1}}},
    "authorization": {"type":"object","required":["authority_ref","approved_payee_ref","amount_limit","currency_or_asset","valid_from","valid_until","evidence_ids"],"properties":{"authority_ref":{"type":"string","minLength":1},"approved_payee_ref":{"type":"string","minLength":1},"amount_limit":{"type":"number","minimum":0},"currency_or_asset":{"type":"string","minLength":1},"valid_from":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"evidence_ids":{"type":"array","items":{"type":"string"},"minItems":1}}},
    "execution": {"type":"object","required":["rail","provider","amount","currency_or_asset","transaction_ref","idempotency_key","attempt","submitted_at"],"properties":{"rail":{"enum":["card","account","stablecoin","prepaid","internal_balance","other"]},"provider":{"type":"string"},"amount":{"type":"number","minimum":0},"currency_or_asset":{"type":"string","minLength":1},"transaction_ref":{"type":["string","null"]},"idempotency_key":{"type":"string","minLength":1},"attempt":{"type":"integer","minimum":1},"submitted_at":{"type":["string","null"],"format":"date-time"}}},
    "settlement": {"type":"object","required":["state","finality_basis","confirmation_ref","settled_at","evidence_ids"],"properties":{"state":{"enum":["not_submitted","submitted","accepted","pending","settled","failed","reversed","unknown"]},"finality_basis":{"type":["string","null"]},"confirmation_ref":{"type":["string","null"]},"settled_at":{"type":["string","null"],"format":"date-time"},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "economics": {"type":"object","required":["principal_amount","fees","fx_cost","slippage","total_cash_cost"],"properties":{"principal_amount":{"type":"number","minimum":0},"fees":{"type":"number","minimum":0},"fx_cost":{"type":"number","minimum":0},"slippage":{"type":"number","minimum":0},"total_cash_cost":{"type":"number","minimum":0}}},
    "reconciliation": {"type":"object","required":["status","invoice_or_usage_ref","treasury_ref","audit_ref","evidence_ids"],"properties":{"status":{"enum":["not_started","pending","matched","break","waived_with_authority"]},"invoice_or_usage_ref":{"type":["string","null"]},"treasury_ref":{"type":["string","null"]},"audit_ref":{"type":["string","null"]},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "dispute": {"type":"object","required":["active","allegation","decision","evidence_ids"],"properties":{"active":{"type":"boolean"},"allegation":{"type":["string","null"]},"decision":{"type":["string","null"]},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "reversal": {"type":"object","required":["requested","executed","amount","idempotency_key","evidence_ids"],"properties":{"requested":{"type":"boolean"},"executed":{"type":"boolean"},"amount":{"type":["number","null"],"minimum":0},"idempotency_key":{"type":["string","null"]},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "authority": {"type":"object","required":["can_execute_payment","can_declare_settled","can_reverse_or_refund","can_close","evidence_ids"],"properties":{"can_execute_payment":{"type":"boolean"},"can_declare_settled":{"type":"boolean"},"can_reverse_or_refund":{"type":"boolean"},"can_close":{"type":"boolean"},"evidence_ids":{"type":"array","items":{"type":"string"}}}},
    "evidence": {"type":"array","items":{"type":"object","required":["id","type","status","observed_at","reference"],"properties":{"id":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"status":{"enum":["current","stale","superseded"]},"observed_at":{"type":"string","format":"date-time"},"reference":{"type":"string","minLength":1}}}},
    "privacy": {"type":"object","required":["contains_credentials","contains_private_keys","contains_card_data","contains_bank_credentials","contains_seed_phrases","contains_bearer_tokens","public_disclosure_confirmed"],"properties":{"contains_credentials":{"const":false},"contains_private_keys":{"const":false},"contains_card_data":{"const":false},"contains_bank_credentials":{"const":false},"contains_seed_phrases":{"const":false},"contains_bearer_tokens":{"const":false},"public_disclosure_confirmed":{"const":true}}}
  }
}
