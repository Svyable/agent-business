{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Svyable/agent-business/schemas/agent-business-compatibility.schema.json",
  "title": "Agent Business Compatibility Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "publisher", "updated_at", "expires_at", "world_model", "conventions", "publication", "disclosure", "compatibility_grants_authority"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_or_business_ref", "identity_evidence_ref"],
      "properties": {
        "agent_or_business_ref": {"type": "string", "minLength": 1},
        "identity_evidence_ref": {"type": ["string", "null"]}
      }
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "world_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "schema_version"],
      "properties": {
        "model_id": {"const": "agent-business-world-model"},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "conventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "spec_version", "support_state", "required_for_transaction", "fallback", "evidence_expires_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "spec_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "support_state": {"enum": ["declared", "tested", "observed_in_production", "independently_verified"]},
          "required_for_transaction": {"type": "boolean"},
          "fallback": {"type": ["string", "null"]},
          "test_evidence_ref": {"type": ["string", "null"]},
          "tested_at": {"type": ["string", "null"], "format": "date-time"},
          "production_evidence_ref": {"type": ["string", "null"]},
          "observed_at": {"type": ["string", "null"], "format": "date-time"},
          "observation_scope": {"type": ["string", "null"]},
          "verifier_ref": {"type": ["string", "null"]},
          "verification_evidence_ref": {"type": ["string", "null"]},
          "verified_at": {"type": ["string", "null"], "format": "date-time"},
          "evidence_expires_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_profile_url", "transport_hints"],
      "properties": {
        "canonical_profile_url": {"type": ["string", "null"]},
        "transport_hints": {
          "type": "array",
          "items": {"enum": ["http", "a2a", "mcp", "ucp", "ap2", "marketplace", "other"]},
          "uniqueItems": true
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_secrets", "contains_credentials", "contains_private_customer_data", "contains_private_prompts", "public_disclosure_confirmed"],
      "properties": {
        "contains_secrets": {"const": false},
        "contains_credentials": {"const": false},
        "contains_private_customer_data": {"const": false},
        "contains_private_prompts": {"const": false},
        "public_disclosure_confirmed": {"const": true}
      }
    },
    "compatibility_grants_authority": {"const": false},
    "certification_claim": {"type": ["string", "null"]}
  }
}
