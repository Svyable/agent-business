{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Svyable/agent-business/schemas/authority-envelope.schema.json",
  "title": "Agent Authority Envelope",
  "type": "object",
  "required": ["schema_version", "authority_id", "principal", "delegate", "purpose", "validity", "status", "scopes", "delegation", "replay", "audit"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "authority_id": {"type": "string", "minLength": 8},
    "parent_authority_id": {"type": ["string", "null"]},
    "principal": {"$ref": "#/$defs/party"},
    "delegate": {"$ref": "#/$defs/party"},
    "purpose": {"type": "string", "minLength": 3},
    "validity": {
      "type": "object",
      "required": ["not_before", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "not_before": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "status": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["draft", "active", "suspended", "revoked", "expired"]},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"},
        "revocation_reason": {"type": ["string", "null"]}
      }
    },
    "scopes": {
      "type": "object",
      "required": ["actions", "tools", "data", "communications", "spend", "geography"],
      "additionalProperties": false,
      "properties": {
        "actions": {"$ref": "#/$defs/stringScope"},
        "tools": {"$ref": "#/$defs/stringScope"},
        "data": {
          "type": "object",
          "required": ["allowed", "prohibited", "purpose_limitation", "retention_days", "onward_sharing"],
          "additionalProperties": false,
          "properties": {
            "allowed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "prohibited": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "purpose_limitation": {"type": "string"},
            "retention_days": {"type": "integer", "minimum": 0},
            "onward_sharing": {"enum": ["none", "named_delegates", "approved_processors"]},
            "consent_reference": {"type": ["string", "null"]}
          }
        },
        "communications": {
          "type": "object",
          "required": ["channels", "audiences", "requires_approval_for"],
          "additionalProperties": false,
          "properties": {
            "channels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "audiences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "requires_approval_for": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "spend": {
          "type": "object",
          "required": ["currency", "per_action_max", "total_max", "approval_threshold"],
          "additionalProperties": false,
          "properties": {
            "currency": {"type": "string", "minLength": 3, "maxLength": 3},
            "per_action_max": {"type": "number", "minimum": 0},
            "total_max": {"type": "number", "minimum": 0},
            "approval_threshold": {"type": "number", "minimum": 0}
          }
        },
        "geography": {"$ref": "#/$defs/stringScope"}
      }
    },
    "delegation": {
      "type": "object",
      "required": ["permitted", "max_depth", "current_depth", "child_must_narrow"],
      "additionalProperties": false,
      "properties": {
        "permitted": {"type": "boolean"},
        "max_depth": {"type": "integer", "minimum": 0},
        "current_depth": {"type": "integer", "minimum": 0},
        "child_must_narrow": {"const": true}
      }
    },
    "replay": {
      "type": "object",
      "required": ["mode", "nonce", "max_uses"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["single_use", "bounded_reuse"]},
        "nonce": {"type": "string", "minLength": 8},
        "max_uses": {"type": "integer", "minimum": 1}
      }
    },
    "audit": {
      "type": "object",
      "required": ["issued_at", "issued_by", "evidence_reference"],
      "additionalProperties": false,
      "properties": {
        "issued_at": {"type": "string", "format": "date-time"},
        "issued_by": {"type": "string", "minLength": 1},
        "evidence_reference": {"type": ["string", "null"]},
        "signature_reference": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["human", "organization", "agent", "service"]}
      }
    },
    "stringScope": {
      "type": "object",
      "required": ["allowed", "prohibited"],
      "additionalProperties": false,
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "prohibited": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
